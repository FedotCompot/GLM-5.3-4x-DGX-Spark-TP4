# TP8 over eight Sparks (docs/tp8.md): layered on current.env when RECIPE_TP_SIZE=8; .env still wins.
# Four slots each hold one 262,144-token request plus the K3 lookahead: 16,394 blocks (projection, unbooted).
export RECIPE_KV_HEAD_BYTES='31404851200'
# Draft vocab shard 19,360 is not a Marlin multiple of 64; eh_proj is qualified only with that head.
export GLM_DRAFT_HEAD='0' GLM_DRAFT_HEAD_INIT='0'
export GLM_DRAFT_EHPROJ='0' GLM_DRAFT_EHPROJ_INIT='0'
# TP4-shaped kernels: L2 hints for 6144x1024/512x6144 MoE GEMMs, attention front for 16 local heads.
export GLM_MARLIN_L2HINT='off'
export GLM_ATTN_FRONT_FUSE='0'
